{
    "name": "Notes (Ubuntu 26.04)",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        // Include gdb, valgrind and heaptrack for interactive debugging.
        "args": { "SETUP_FLAGS": "" }
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/notebook,type=bind",
    "workspaceFolder": "/workspaces/notebook",
    // Same volume as scripts/dev-container.sh: keeps container builds out of the
    // host's build/ directory.
    "mounts": ["source=notesapp-build,target=/workspaces/notebook/build,type=volume"],
    "remoteUser": "ubuntu",
    // LeakSanitizer and gdb need ptrace.
    "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],
    "customizations": {
        "vscode": {
            "extensions": ["llvm-vs-code-extensions.vscode-clangd", "ms-vscode.cmake-tools"],
            "settings": {
                "cmake.useCMakePresets": "always",
                "clangd.arguments": ["--compile-commands-dir=build/debug"]
            }
        }
    }
}
