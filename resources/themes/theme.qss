/*
 * App style sheet, shared by the light and dark themes. Placeholders (a dollar
 * sign followed by a ThemeColors field name in braces) are replaced with that
 * theme's colors by ThemeManager::styleSheet().
 * Most colors come from the palette; this file only styles what the palette
 * can't reach.
 */

/*
 * No QMainWindow background: the window is translucent around its content for
 * the drop shadow, and WindowChrome paints the content background (task 1.9).
 */

/* Header row (task 1.9): menus on the left, window buttons on the right. */
QMenuBar#headerBar {
    background: ${window};
    color: ${text};
    padding: 2px 4px 0 4px;
}

QMenuBar#headerBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 6px;
}

QMenuBar#headerBar::item:selected,
QMenuBar#headerBar::item:pressed {
    background: ${hover};
}

#windowButtons QToolButton {
    border: none;
    border-radius: 12px;
    padding: 4px;
    background: ${hover};
}

#windowButtons QToolButton:hover {
    background: ${separator};
}

/* Toolbar: macOS-style groups of joined buttons, a hairline under it. */
QToolBar#mainToolBar {
    background: ${window};
    border: none;
    border-bottom: 1px solid ${separator};
    padding: 4px 8px 6px 8px; /* group spacing is set in MainWindow */
}

QFrame#toolGroup {
    background: ${base};
    border: 1px solid ${separator};
    border-radius: 7px;
}

QFrame#toolGroup QToolButton {
    border: none;
    border-radius: 0;
    padding: 3px 8px;
    background: transparent;
}

QFrame#toolGroup QToolButton[position="first"],
QFrame#toolGroup QToolButton[position="middle"] {
    border-right: 1px solid ${separator};
}

QFrame#toolGroup QToolButton:hover,
QFrame#toolGroup QToolButton:checked {
    background: ${hover};
}

QFrame#toolGroup QToolButton[position="first"] {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

QFrame#toolGroup QToolButton[position="last"] {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QFrame#toolGroup QToolButton[position="only"] {
    border-radius: 6px;
}

QLineEdit#searchField {
    background: ${base};
    color: ${text};
    border: 1px solid ${separator};
    border-radius: 7px;
    padding: 3px 4px;
    selection-background-color: ${accent};
    selection-color: ${accentText};
}

QLineEdit#searchField:focus {
    border-color: ${accent};
}

/* Panes. */
#sidebarPane {
    background: ${sidebar};
}

#sidebarPane QToolButton {
    color: ${text};
    border: none;
    padding: 4px 8px;
}

#sidebarPane QToolButton:disabled {
    color: ${mutedText};
}

#noteListPane,
#editorPane,
#noteTextEdit {
    background: ${base};
    border: none;
}

/* A 1 px line in the middle of a wider, easier to grab, splitter handle. */
QSplitter#mainSplitter::handle {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 ${base}, stop: 0.4 ${base},
                                stop: 0.4 ${separator}, stop: 0.6 ${separator},
                                stop: 0.6 ${base}, stop: 1 ${base});
}
