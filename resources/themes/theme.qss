/*
 * App style sheet, shared by the light and dark themes. Placeholders (a dollar
 * sign followed by a ThemeColors field name in braces) are replaced with that
 * theme's colors by ThemeManager::styleSheet().
 * Most colors come from the palette; this file only styles what the palette
 * can't reach.
 */

/*
 * No QMainWindow background: the window is translucent around its content for
 * the drop shadow, and WindowChrome paints the content background (task 1.9).
 */

/* Header row (task 1.9): menus on the left, window buttons on the right. */
QMenuBar#headerBar {
    background: ${window};
    color: ${text};
    padding: 7px 10px 0 10px; /* clear of the rounded corners */
}

QMenuBar#headerBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 6px;
}

QMenuBar#headerBar::item:selected,
QMenuBar#headerBar::item:pressed {
    background: ${hover};
}

/* Menus: no rules here. Any QMenu rule makes Qt draw menus itself, ignoring
   AppStyle, which draws them (rounded, shadowed, right-aligned shortcuts). */

/* GNOME-sized: 22 px circles, 14 px icons (sizes set in WindowChrome). */
#windowButtons QToolButton {
    border: none;
    border-radius: 11px;
    padding: 0;
    background: ${hover};
}

#windowButtons QToolButton:hover {
    background: ${separator};
}

/* Toolbar: macOS-style groups of joined buttons, a hairline under it. */
QToolBar#mainToolBar {
    background: ${window};
    border: none;
    border-bottom: 1px solid ${separator};
    /* Qt applies one uniform margin here; MainWindow adds the uneven rest so the
       gaps above and below the buttons match. */
    padding: 4px;
    spacing: 8px; /* between groups */
}

QFrame#toolGroup {
    background: ${base};
    border: 1px solid ${separator};
    border-radius: 7px;
}

QFrame#toolGroup QToolButton {
    border: none;
    border-radius: 0;
    padding: 3px 8px;
    background: transparent;
}

QFrame#toolGroup QToolButton[position="first"],
QFrame#toolGroup QToolButton[position="middle"] {
    border-right: 1px solid ${separator};
}

QFrame#toolGroup QToolButton:hover,
QFrame#toolGroup QToolButton:checked {
    background: ${hover};
}

QFrame#toolGroup QToolButton[position="first"] {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

QFrame#toolGroup QToolButton[position="last"] {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QFrame#toolGroup QToolButton[position="only"] {
    border-radius: 6px;
}

/* The Aa menu's row of inline formats (B I U S). */
#formatInlineRow QToolButton {
    color: ${text};
    border: none;
    border-radius: 6px;
    padding: 2px;
    min-width: 30px;
    min-height: 28px;
    background: transparent;
}

#formatInlineRow QToolButton:hover,
#formatInlineRow QToolButton:checked {
    background: ${hover};
}

#formatInlineRow QToolButton:disabled {
    color: ${mutedText};
}

/* Aa opens the Format menu: no arrow, it would crowd the icon. */
QFrame#toolGroup QToolButton::menu-indicator {
    image: none;
    width: 0;
}

QLineEdit#searchField {
    background: ${base};
    color: ${text};
    border: 1px solid ${separator};
    border-radius: 7px;
    padding: 0 6px; /* height comes from the button groups (MainWindow) */
    selection-background-color: ${accent};
    selection-color: ${accentText};
}

QLineEdit#searchField:focus {
    border-color: ${accent};
}

/* Alerts (AlertDialog): an optional name field, full-width buttons, the
   confirming one in the accent. */
QLineEdit#alertField {
    background: ${base};
    color: ${text};
    border: 1px solid ${separator};
    border-radius: 7px;
    padding: 5px 8px;
    selection-background-color: ${accent};
    selection-color: ${accentText};
}

QLineEdit#alertField:focus {
    border-color: ${accent};
}

QPushButton[alertRole="accept"],
QPushButton[alertRole="cancel"] {
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 6px 12px;
}

QPushButton[alertRole="accept"] {
    background: ${accent};
    color: ${accentText};
}

QPushButton[alertRole="cancel"] {
    background: ${base};
    color: ${text};
    border-color: ${separator};
}

QPushButton[alertRole="accept"]:hover,
QPushButton[alertRole="accept"]:focus {
    border-color: ${accentText};
}

QPushButton[alertRole="cancel"]:hover,
QPushButton[alertRole="cancel"]:focus {
    border-color: ${mutedText};
}

/* Panes. */
#sidebarPane {
    background: ${sidebar};
}

#sidebarPane QToolButton {
    color: ${text};
    border: none;
    padding: 4px 8px;
}

#sidebarPane QToolButton:disabled {
    color: ${mutedText};
}

#noteListPane,
#editorPane,
#noteTextEdit {
    background: ${base};
    border: none;
}

/* A 1 px line in the middle of a wider, easier to grab, splitter handle. */
QSplitter#mainSplitter::handle {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 ${base}, stop: 0.4 ${base},
                                stop: 0.4 ${separator}, stop: 0.6 ${separator},
                                stop: 0.6 ${base}, stop: 1 ${base});
}

/* Scroll bars: no rules here, AppStyle draws them (thin rounded handle; on
   hover a track appears and the handle darkens). A QScrollBar rule would make
   Qt draw them itself. */
